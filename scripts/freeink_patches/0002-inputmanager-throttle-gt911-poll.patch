@@ -1782,6 +1782,7 @@ void InputManager::beginGt911() {
 }
 
 bool InputManager::gt911ReadReg(const uint16_t reg, uint8_t* buf, const uint8_t len) {
+  touchReads++;
   Wire.beginTransmission(gt911Addr);
   Wire.write(static_cast<uint8_t>(reg >> 8));
   Wire.write(static_cast<uint8_t>(reg & 0xFF));
@@ -2054,6 +2055,11 @@ void InputManager::pollGt911(const unsigned long now) {
   if (gt911Addr == 0) {
     return;
   }
+  // Same cadence as the other polled controllers. Unthrottled, a main loop that
+  // spins (chapter builds, transfers) reads the status register thousands of
+  // times a second; the GT911 itself reports a new frame at most every ~10 ms.
+  if (now < touchReadAt) return;
+  touchReadAt = now + TOUCH_SAMPLE_DELAY_MS;
   uint8_t status = 0;
