Subject: InputManager: throttle the GT911 poll and count touch reads

pollGt911() read the status register on every serviceTouch() call, so a main
loop that spins (chapter builds, transfers) issued thousands of I2C reads a
second. Rate-limit it to TOUCH_SAMPLE_DELAY_MS (8 ms), the cadence the CHSC6x,
FT5x06, FT6336U and GSLx680 paths already use; the GT911 reports a new frame
at most every ~10 ms, so no contact frame is lost and touch latency grows by at
most 8 ms. Also expose touchReadCount(), a plain counter of GT911 register
reads, for host power diagnostics.

diff --git a/libs/hardware/InputManager/include/InputManager.h b/libs/hardware/InputManager/include/InputManager.h
index a8092c4..ae9817e 100644
--- a/libs/hardware/InputManager/include/InputManager.h
+++ b/libs/hardware/InputManager/include/InputManager.h
@@ -260,6 +260,11 @@ class InputManager {
   // samples report raw = -1, button = -1.
   void readButtonAdc(ButtonAdcSample& group1, ButtonAdcSample& group2);
 
+  // GT911 register reads since boot (status and point reads, failed ones
+  // included; 0 on other controllers). A plain counter for host power
+  // diagnostics.
+  uint32_t touchReadCount() const { return touchReads; }
+
  private:
   static ButtonHook s_buttonHook;
 
@@ -366,6 +371,7 @@ class InputManager {
   uint8_t gt911Addr = 0;                 // resolved GT911 address (0 until probed)
   unsigned long touchIrqPulseUntil = 0;  // synthesized-confirm window after a press
   unsigned long touchReadAt = 0;         // next scheduled I2C poll
+  uint32_t touchReads = 0;               // see touchReadCount()
   unsigned long touchReleaseAt = 0;
   bool touchPressed = false;
   bool touchPressedEvent = false;
diff --git a/libs/hardware/InputManager/src/InputManager.cpp b/libs/hardware/InputManager/src/InputManager.cpp
